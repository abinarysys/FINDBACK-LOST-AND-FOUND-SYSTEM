<%# Shared heading area for account pages. %>
<%
    /* Top navigation + welcome hero + pill tabs for the user dashboard pages.
       Expects: user (object) and activePage:
         'profile' | 'notifications' | 'items' | 'claims' | 'chat' | 'settings'
       Styles: /css/user/user-shell.css (+ user-ui.css for the design tokens). */
    const initial = user && user.full_name ? user.full_name.charAt(0).toUpperCase() : 'U';
    const tabs = [
        { key: 'profile',       href: '/user/profile',       label: 'Profile',
          icon: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>' },
        { key: 'notifications', href: '/user/notifications', label: 'Notifications',
          icon: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>' },
        { key: 'items',         href: '/user/items', label: 'My Items',
          icon: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>' },
        { key: 'claims',        href: '/user/claims',        label: 'My Claims',
          icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 12 2 2 4-4"/>' },
        { key: 'chat',          href: '/user/chat',          label: 'Chat',
          icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>' },
        { key: 'settings',      href: '/user/settings',      label: 'Settings',
          icon: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>' }
    ];
%>
<!-- ============ Top navigation (shared with the whole site) ============ -->
<%- include('navbar', { user: user }) %>

<!-- ============ Welcome hero ============ -->
<section class="u-hero">
    <div class="u-wrap u-hero-in">
        <a href="/user/profile" class="u-hero-avatar" aria-label="Open my profile">
            <% if (user.profile_image) { %>
                <img src="<%= user.profile_image %>" alt="Profile picture of <%= user.full_name %>">
            <% } else { %>
                <span><%= initial %></span>
            <% } %>
        </a>
        <div class="u-hero-text">
            <h1>Welcome, <%= user.full_name %></h1>
            <p>Manage your lost and found items</p>
        </div>
    </div>
</section>

<!-- ============ Pill tabs ============ -->
<div class="u-wrap">
    <nav class="u-tabs" aria-label="My account">
        <% tabs.forEach(function (t) { %>
            <a href="<%= t.href %>" class="u-tab <%= activePage === t.key ? 'active' : '' %>"
               <%- activePage === t.key ? 'aria-current="page"' : '' %>>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- t.icon %></svg>
                <span><%= t.label %></span>
                <% if (t.key === 'notifications') { %>
                    <span class="nav-count" id="navNotifCount" hidden>0</span>
                <% } %>
            </a>
        <% }) %>
    </nav>
</div>
