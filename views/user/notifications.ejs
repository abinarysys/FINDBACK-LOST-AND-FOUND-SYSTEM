<%# Displays the signed-in user's notifications. %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Notifications | FINDBACK</title>

    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <link rel="stylesheet" href="/css/user/user-ui.css">
    <link rel="stylesheet" href="/css/user/user-shell.css">
    <link rel="stylesheet" href="/css/user/notif.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;500;600&display=swap" rel="stylesheet">
</head>

<body>
    <%- include('partials/user-header', {
        user: user,
        activePage: 'notifications'
    }) %>

    <main class="u-main">

        <section class="notifications-content">
            <div class="page-heading">
                <div>
                    <h1>Notifications</h1>
                    <p>Stay updated on your lost and found claims.</p>
                </div>

                <div class="page-heading-actions">
                    <span class="notification-count">
                        <%= notifications.length %>
                        <%= notifications.length === 1 ? 'notification' : 'notifications' %>
                    </span>
                    <button type="button" class="mark-all-btn" id="pageMarkAll">Mark all as read</button>
                </div>
            </div>

            <div class="notifications-card">
                <div class="notifications-card-header">
                    <h2>Your Notifications</h2>
                    <p>Updates about your claims and found items.</p>
                </div>

                <% if (notifications && notifications.length > 0) { %>
                    <div class="notification-list">
                        <% notifications.forEach(notification => { %>
                            <article
                                class="notification-item <%= Number(notification.is_read) === 1 ? 'read' : 'unread' %>"
                                data-notification-id="<%= notification.notification_id %>"
                            >
                                <div class="notification-icon <%= notification.type %>">
                                    <% if (notification.type === 'claim_verified') { %>
                                        ✓
                                    <% } else if (notification.type === 'claim_rejected') { %>
                                        ×
                                    <% } else { %>
                                        ●
                                    <% } %>
                                </div>

                                <div class="notification-details">
                                    <div class="notification-title-row">
                                        <h3><%= notification.title || 'Notification' %></h3>

                                        <% if (Number(notification.is_read) !== 1) { %>
                                            <span class="new-badge">New</span>
                                        <% } %>
                                    </div>

                                    <p class="notification-message">
                                        <%= notification.message %>
                                    </p>

                                    <% if (notification.found_item_id && notification.item_name) { %>
                                        <div class="notification-item-card">
                                            <div class="notification-item-photo">
                                                <% if (notification.photo_path) { %>
                                                    <img
                                                        src="<%= notification.photo_path.startsWith('/') ? notification.photo_path : '/' + notification.photo_path %>"
                                                        alt="<%= notification.item_name %>"
                                                        loading="lazy"
                                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                                    >
                                                    <div class="item-photo-placeholder" style="display:none;">
                                                        <span>▧</span>
                                                        <small>No image available</small>
                                                    </div>
                                                <% } else { %>
                                                    <div class="item-photo-placeholder">
                                                        <span>▧</span>
                                                        <small>No image available</small>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <div class="notification-item-info">
                                                <span class="item-card-label">FOUND ITEM</span>
                                                <h4><%= notification.item_name %></h4>

                                                <% if (notification.category_name) { %>
                                                    <p>
                                                        <span class="detail-label">Category:</span>
                                                        <%= notification.category_name %>
                                                    </p>
                                                <% } %>

                                                <% if (notification.item_location) { %>
                                                    <p>
                                                        <span class="detail-label">Location:</span>
                                                        <%= notification.item_location %>
                                                    </p>
                                                <% } %>

                                                <% if (notification.date_found) { %>
                                                    <p>
                                                        <span class="detail-label">Date found:</span>
                                                        <%= new Date(notification.date_found).toLocaleDateString('en-PH', {
                                                            year: 'numeric',
                                                            month: 'short',
                                                            day: 'numeric',
                                                            timeZone: 'UTC'
                                                        }) %>
                                                    </p>
                                                <% } %>

                                                <% if (notification.item_description) { %>
                                                    <p class="item-description">
                                                        <%= notification.item_description %>
                                                    </p>
                                                <% } %>

                                                <% if (notification.type === 'claim_verified') { %>
                                                    <span class="claim-status verified">Claim verified</span>
                                                <% } else if (notification.type === 'claim_rejected') { %>
                                                    <span class="claim-status rejected">Claim not approved</span>
                                                <% } %>
                                            </div>
                                        </div>

                                        <% if (notification.related_user_id &&
                                              Number(notification.related_user_id) !== Number(user.user_id)) { %>
                                            <a
                                                class="message-claimant-button"
                                                href="/user/chat?user_id=<%= encodeURIComponent(notification.related_user_id) %>&item_id=<%= encodeURIComponent(notification.found_item_id) %>&claim_id=<%= encodeURIComponent(notification.claim_id || '') %>"
                                            >
                                                Message the Claimant
                                            </a>
                                        <% } %>
                                    <% } %>

                                    <span class="notification-date">
                                        <% if (notification.created_at) { %>
                                            <%= new Date(notification.created_at).toLocaleString('en-PH', {
                                                dateStyle: 'medium',
                                                timeStyle: 'short'
                                            }) %>
                                        <% } %>
                                    </span>

                                    <% if (notification.action_url) { %>
                                        <a class="view-claim-button" href="<%= notification.action_url %>">View Claim</a>
                                    <% } else if (notification.link && !notification.found_item_id) { %>
                                        <a class="notification-link" href="<%= notification.link %>">
                                            View details →
                                        </a>
                                    <% } %>

                                    <% if (Number(notification.is_read) !== 1) { %>
                                        <button type="button" class="mark-read-btn" data-id="<%= notification.notification_id %>">Mark as read</button>
                                    <% } %>
                                </div>

                                <% if (Number(notification.is_read) !== 1) { %>
                                    <span class="unread-dot" title="Unread"></span>
                                <% } %>
                            </article>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-notifications">
                        <div class="empty-icon">♧</div>
                        <h3>No notifications yet</h3>
                        <p>Updates about your claims and lost and found items will appear here.</p>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

</body>
</html>
