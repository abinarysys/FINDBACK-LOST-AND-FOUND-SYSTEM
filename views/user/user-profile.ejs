<%# Displays the signed-in user's profile information and account links. %>
<%
    // This setup prepares display values before HTML is sent; locals come from routers/userprofile-router.js.
    // EJS statements calculate values; escaped output displays text safely; includes insert reusable templates.
    // Use the first character as a fallback when no profile photo exists.
    const initial = user.full_name ? user.full_name.charAt(0).toUpperCase() : 'U';

    // Convert stored dates to a short display date; missing values show a dash.
    const fmtDate = (value) => value
        ? new Date(value).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' })
        : '—';

    // These maps turn database claim states into CSS badge classes and readable labels.
    const claimBadge = { pending: 'badge-warning', verified: 'badge-success', rejected: 'badge-danger' };
    const claimLabel = { pending: 'Pending', verified: 'Approved', rejected: 'Not approved' };

    // These helpers return CSS class names; the stylesheet determines each badge color.
    const accountBadge = (status) => status === 'active' ? 'badge-success' : 'badge-danger';
    const verifyBadge = { pending: 'badge-warning', verified: 'badge-success', rejected: 'badge-danger' };
%>
<%# The browser receives this HTML after EJS evaluates the template on the server. %>
<!DOCTYPE html>
<html lang="en">
<%# The head declares browser metadata, the page title/icon, fonts, and the CSS files that style this page. %>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile | FindBack</title>

    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/user/user-ui.css">
    <link rel="stylesheet" href="/css/user/user-shell.css">
    <link rel="stylesheet" href="/css/modern-ui.css">
</head>
<%# The body holds visible page content. The shared header is rendered first, then this page main content. %>
<body>
    <%# Reuse the account header, passing the user and telling it the Profile tab is active. %>
    <%- include('partials/user-header', { user: user, activePage: 'profile' }) %>

    <main class="u-main">

        <%# The controller/flash middleware supplies message arrays; forEach renders each message separately. %>
        <!-- Flash messages (e.g. "Profile updated successfully.") -->
        <% (typeof success !== 'undefined' ? success : []).forEach(function (msg) { %>
            <div class="alert alert-success" role="status"><%= msg %></div>
        <% }) %>
        <% (typeof error !== 'undefined' ? error : []).forEach(function (msg) { %>
            <div class="alert alert-error" role="alert"><%= msg %></div>
        <% }) %>

        <%# The heading introduces the page; this anchor opens the edit-profile route. %>
        <header class="page-head">
            <div>
                <h1>My Profile</h1>
                <p>View and manage your personal information, items and claims.</p>
            </div>
            <div class="page-actions">
                <a class="btn btn-primary" href="/user/profile/edit">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    Edit Profile
                </a>
            </div>
        </header>

        <%# Each summary card prints one count from the stats object prepared by the profile route. %>
        <!-- Quick numbers -->
        <section class="stats" aria-label="Your activity summary">
            <div class="stat">
                <div class="stat-icon">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>
                </div>
                <div><p>Found items reported</p><strong><%= stats.found %></strong></div>
            </div>
            <div class="stat">
                <div class="stat-icon warn">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <div><p>Lost items reported</p><strong><%= stats.lost %></strong></div>
            </div>
            <div class="stat">
                <div class="stat-icon">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div><p>Claims made</p><strong><%= stats.claims %></strong></div>
            </div>
            <div class="stat">
                <div class="stat-icon ok">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div><p>Claims approved</p><strong><%= stats.approved %></strong></div>
            </div>
        </section>

        <%# This two-column section pairs account fields with a profile identity card. %>
        <!-- Personal information + identity card -->
        <section class="grid-2">
            <article class="panel">
                <div class="panel-head">
                    <div>
                        <h2>Personal Information</h2>
                        <p>Your registered account details</p>
                    </div>
                </div>
                <div class="panel-body">
                    <%# A definition list pairs each dt label with its dd value. %>
                    <dl class="detail-list">
                        <dt>Full name</dt>
                        <dd><%= user.full_name || 'Not provided' %></dd>

                        <dt>Email</dt>
                        <dd><%= user.email || 'Not provided' %></dd>

                        <dt>Contact number</dt>
                        <dd><%= user.contact_number || 'Not provided' %></dd>

                        <dt>Account role</dt>
                        <dd style="text-transform:capitalize"><%= user.role || 'user' %></dd>

                        <dt>Account status</dt>
                        <dd><span class="badge <%= accountBadge(user.account_status) %>"><%= user.account_status || 'unknown' %></span></dd>

                        <dt>Verification</dt>
                        <dd><span class="badge <%= verifyBadge[user.verification_status] || 'badge-neutral' %>"><%= user.verification_status || 'pending' %></span></dd>

                        <dt>Member since</dt>
                        <dd><%= fmtDate(user.created_at) %></dd>

                        <dt>User ID</dt>
                        <dd>#<%= user.user_id %></dd>
                    </dl>
                </div>
            </article>

            <article class="panel">
                <%# Show the uploaded profile image, or the generated first initial as a fallback. %>
                <div class="panel-body user-hero">
                    <% if (user.profile_image) { %>
                        <img class="avatar av-lg" src="<%= user.profile_image %>" alt="Profile picture of <%= user.full_name %>">
                    <% } else { %>
                        <span class="avatar av-lg"><%= initial %></span>
                    <% } %>
                    <h2><%= user.full_name || 'User' %></h2>
                    <p class="muted"><%= user.email || '' %></p>
                    <div class="badges">
                        <span class="badge badge-primary"><%= user.role || 'user' %></span>
                        <span class="badge <%= accountBadge(user.account_status) %>"><%= user.account_status || 'unknown' %></span>
                    </div>
                    <a class="btn btn-ghost btn-block" style="margin-top:12px" href="/user/profile/edit">Edit profile</a>
                </div>
            </article>
        </section>

        <%# Claims arrive from the route ordered by submission time; the conditional chooses a table or empty state. %>
        <!-- Claim history -->
        <section class="panel" style="margin-bottom:20px">
            <div class="panel-head">
                <div>
                    <h2>Claim History</h2>
                    <p>Your most recent claims and their status</p>
                </div>
                <a class="btn btn-ghost btn-sm" href="/user/notifications">Notifications</a>
            </div>

            <%# Choose the table when claims exist; otherwise show the empty state below. %>
            <% if (claims.length) { %>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th>Submitted</th>
                                <th>Status</th>
                                <th>Reviewed</th>
                                <th class="num">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <%# Render one row for each claim; c is the current claim in this loop. %>
                            <% claims.forEach(function (c) { %>
                                <tr>
                                    <td><strong style="color:var(--text);font-weight:600"><%= c.item_name %></strong></td>
                                    <td><%= fmtDate(c.created_at) %></td>
                                    <td><span class="badge <%= claimBadge[c.status] || 'badge-neutral' %>"><%= claimLabel[c.status] || c.status %></span></td>
                                    <td><%= fmtDate(c.reviewed_at) %></td>
                                    <td class="num">
                                        <div class="row-actions">
                                            <a class="btn btn-ghost btn-sm" href="/user/claims/<%= c.claim_id %>">View Claim</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <%# The profile shows up to five claims, so this note appears when more exist. %>
                <% if (stats.claims > claims.length) { %>
                    <div class="panel-foot"><span>Showing the latest <%= claims.length %> of <%= stats.claims %> claims.</span></div>
                <% } %>
            <% } else { %>
                <div class="empty">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <p>You haven't made any claims yet.</p>
                </div>
            <% } %>
        </section>

        <%# Recent lost and found reports are combined into the items array by the profile route. %>
        <!-- Reported items -->
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>My Reported Items</h2>
                    <p>Lost and found items you reported</p>
                </div>
                <a class="btn btn-ghost btn-sm" href="/user/items">All items</a>
            </div>

            <%# Choose the recent-item list when rows exist; otherwise show the empty state. %>
            <% if (items.length) { %>
                <ul class="list">
                    <%# Render one item card row; type/status values control the visible badges and labels. %>
                    <% items.forEach(function (item) { %>
                        <li>
                            <span class="badge <%= item.type === 'found' ? 'badge-success' : 'badge-warning' %> type-chip"><%= item.type %></span>
                            <div class="grow">
                                <strong><%= item.title %></strong>
                                <small>
                                    <%= item.category_name ? item.category_name + ' · ' : '' %><%= item.location ? item.location + ' · ' : '' %><%= fmtDate(item.created_at) %>
                                </small>
                            </div>
                            <%# Only render a status badge when this database row has a status value. %>
                            <% if (item.status) { %>
                                <span class="badge <%= item.status === 'available' ? 'badge-success' : (item.status === 'claimed' ? 'badge-primary' : 'badge-neutral') %>"><%= item.status %></span>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <div class="empty">
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>
                    <p>You haven't reported any items yet.</p>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>
