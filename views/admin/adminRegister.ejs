<%- include('partials/head', { title: 'Admin setup' }) %>
<body>
<div class="auth">
    <section class="auth-brand">
        <span class="brand-mark">F</span>
        <h1>Set up FindBack Admin</h1>
        <p>Create the first administrator account. After this, new admins are added from Settings by an existing admin.</p>
    </section>

    <section class="auth-form-wrap">
        <div class="auth-card">
            <h2>Create first admin</h2>
            <p>This page closes automatically once an admin exists.</p>

            <%- include('partials/flash') %>

            <form method="POST" action="/admin/register/user" enctype="multipart/form-data" novalidate>
                <div class="field">
                    <label for="name">Full name</label>
                    <input class="input" id="name" name="name" type="text" placeholder="Juan Dela Cruz" required>
                </div>
                <div class="field">
                    <label for="email">Email address</label>
                    <input class="input" id="email" name="email" type="email" placeholder="admin@email.com" required>
                </div>
                <div class="field">
                    <label for="num">Contact number</label>
                    <input class="input" id="num" name="num" type="text" inputmode="numeric" maxlength="11" placeholder="09123456789">
                </div>
                <div class="field">
                    <label for="pw">Password</label>
                    <input class="input" id="pw" name="pw" type="password" minlength="8" autocomplete="new-password" placeholder="At least 8 characters" required>
                </div>
                <div class="field">
                    <label for="pfp">Profile picture <span class="muted">(optional)</span></label>
                    <input class="input" id="pfp" name="pfp" type="file" accept="image/*">
                </div>
                <button class="btn btn-primary btn-block" type="submit">Create admin</button>
            </form>

            <p class="auth-foot">Already have an account? <a href="/admin/login">Sign in</a></p>
        </div>
    </section>
</div>
<%- include('partials/foot') %>
