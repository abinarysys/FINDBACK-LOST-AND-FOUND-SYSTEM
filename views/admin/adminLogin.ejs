<%- include('partials/head', { title: 'Sign in' }) %>
<body>
<div class="auth">
    <section class="auth-brand">
        <span class="brand-mark">F</span>
        <h1>FindBack Admin</h1>
        <p>Manage users, review reports and keep the lost &amp; found community running smoothly.</p>
    </section>

    <section class="auth-form-wrap">
        <div class="auth-card">
            <h2>Welcome back</h2>
            <p>Sign in with your administrator account.</p>

            <%- include('partials/flash') %>

            <form method="POST" action="/admin/login/user" novalidate>
                <div class="field">
                    <label for="email">Email address</label>
                    <input class="input" id="email" name="email" type="email" autocomplete="username" placeholder="admin@email.com" required autofocus>
                </div>
                <div class="field">
                    <label for="pw">Password</label>
                    <input class="input" id="pw" name="pw" type="password" autocomplete="current-password" placeholder="Your password" required>
                </div>
                <button class="btn btn-primary btn-block" type="submit">Sign in</button>
            </form>

            <% if (locals.allowSetup) { %>
                <p class="auth-foot">No admin yet? <a href="/admin/register">Create the first admin</a></p>
            <% } %>
            <p class="auth-foot"><a href="/">&larr; Back to FindBack</a></p>
        </div>
    </section>
</div>
<%- include('partials/foot') %>
