<%- include('partials/head', { title: 'Manage Users' }) %>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/flash') %>

    <header class="page-head">
        <div><h1>Manage Users</h1><p>View registered users and activate or deactivate accounts.</p></div>
    </header>

    <%
        const nActive = users.filter(u => u.account_status === 'active').length;
        const nInactive = users.length - nActive;
    %>
    <section class="panel">
        <div class="toolbar">
            <label class="search">
                <%- icon('search') %>
                <input class="input" type="search" placeholder="Search name, email or number" data-search="usersTable" aria-label="Search users">
            </label>
            <div class="chips">
                <button type="button" class="chip active" data-filter="usersTable" data-key="status" data-value="">All <em><%= users.length %></em></button>
                <button type="button" class="chip" data-filter="usersTable" data-key="status" data-value="active">Active <em><%= nActive %></em></button>
                <button type="button" class="chip" data-filter="usersTable" data-key="status" data-value="inactive">Inactive <em><%= nInactive %></em></button>
            </div>
            <button type="button" class="btn btn-ghost btn-sm spacer" data-export="usersTable" data-name="users"><%- icon('download') %>Export CSV</button>
        </div>

        <div class="table-wrap">
            <table class="table" id="usersTable">
                <thead><tr><th>User</th><th>Contact</th><th>Joined</th><th>Verification</th><th>Status</th><th class="num">Action</th></tr></thead>
                <tbody>
                <% users.forEach(function (u) { %>
                    <tr data-row data-status="<%= u.account_status %>">
                        <td><div class="cell-user"><%- avatar(u.full_name, u.profile_image) %><div><strong><%= u.full_name %></strong><small><%= u.email %></small></div></div></td>
                        <td><%= u.contact_number || '—' %></td>
                        <td><%= fmtDate(u.created_at) %></td>
                        <td><span class="badge <%= badge(u.verification_status) %>"><%= u.verification_status %></span></td>
                        <td><span class="badge <%= badge(u.account_status) %>"><%= u.account_status %></span></td>
                        <td>
                            <div class="row-actions">
                            <% if (u.account_status === 'active') { %>
                                <button class="btn btn-danger btn-sm" data-action data-method="PATCH"
                                        data-url="/admin/users/<%= u.user_id %>/status" data-body='{"status":"inactive"}'
                                        data-confirm="Deactivate <%= u.full_name %>? They will not be able to sign in.">Deactivate</button>
                            <% } else { %>
                                <button class="btn btn-success btn-sm" data-action data-method="PATCH"
                                        data-url="/admin/users/<%= u.user_id %>/status" data-body='{"status":"active"}'>Activate</button>
                            <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
        <div class="empty" data-empty="usersTable" <%= users.length ? 'hidden' : '' %>><%- icon('users') %><p>No users found.</p></div>
        <div class="panel-foot"><span>Showing <b data-count="usersTable"><%= users.length %></b> of <%= users.length %> users</span></div>
    </section>
</main>
<%- include('partials/foot') %>
