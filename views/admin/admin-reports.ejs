<%- include('partials/head', { title: 'Reports' }) %>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/flash') %>

    <header class="page-head">
        <div><h1>Reports</h1><p>Summary of everything reported on FindBack.</p></div>
        <div class="page-actions">
            <button type="button" class="btn btn-ghost" onclick="window.print()"><%- icon('file') %>Print</button>
            <button type="button" class="btn btn-primary" data-export="reportsTable" data-name="reports"><%- icon('download') %>Export CSV</button>
        </div>
    </header>

    <section class="stats">
        <div class="stat"><span class="stat-icon"><%- icon('users') %></span><div><p>Total Users</p><strong><%= totalUsers %></strong></div></div>
        <div class="stat"><span class="stat-icon"><%- icon('search') %></span><div><p>Lost Reports</p><strong><%= totalLost %></strong></div></div>
        <div class="stat"><span class="stat-icon ok"><%- icon('box') %></span><div><p>Found Reports</p><strong><%= totalFound %></strong></div></div>
        <div class="stat"><span class="stat-icon"><%- icon('file') %></span><div><p>All Reports</p><strong><%= totalReports %></strong></div></div>
    </section>

    <section class="grid-2">
        <article class="panel">
            <div class="toolbar">
                <label class="search">
                    <%- icon('search') %>
                    <input class="input" type="search" placeholder="Search reports" data-search="reportsTable" aria-label="Search reports">
                </label>
                <div class="chips">
                    <button type="button" class="chip active" data-filter="reportsTable" data-key="type" data-value="">All</button>
                    <button type="button" class="chip" data-filter="reportsTable" data-key="type" data-value="Lost">Lost</button>
                    <button type="button" class="chip" data-filter="reportsTable" data-key="type" data-value="Found">Found</button>
                </div>
            </div>
            <div class="table-wrap">
                <table class="table" id="reportsTable">
                    <thead><tr><th>ID</th><th>Item</th><th>Type</th><th>Reported by</th><th>Date</th><th>Status</th></tr></thead>
                    <tbody>
                    <% reports.forEach(function (r) { %>
                        <tr data-row data-type="<%= r.report_type %>">
                            <td>#<%= r.id %></td>
                            <td><strong style="color:var(--text)"><%= r.item_name %></strong></td>
                            <td><span class="badge <%= r.report_type === 'Lost' ? 'badge-primary' : 'badge-success' %>"><%= r.report_type %></span></td>
                            <td><%= r.reported_by || 'Unknown' %></td>
                            <td><%= fmtDate(r.created_at) %></td>
                            <td><span class="badge <%= badge(r.status) %>"><%= r.status %></span></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="empty" data-empty="reportsTable" <%= reports.length ? 'hidden' : '' %>><%- icon('file') %><p>No reports yet.</p></div>
            <div class="panel-foot"><span>Showing <b data-count="reportsTable"><%= reports.length %></b> latest reports</span></div>
        </article>

        <article class="panel">
            <div class="panel-head"><div><h2>Report categories</h2><p>Lost + found combined</p></div></div>
            <div class="panel-body">
                <% const max = Math.max(1, ...reportCategories.map(function (c) { return Number(c.total) || 0; })); %>
                <% reportCategories.forEach(function (c) { %>
                    <div class="bar-row">
                        <span><%= c.category_name %></span>
                        <div class="bar"><i data-w="<%= Math.round(((Number(c.total) || 0) / max) * 100) %>"></i></div>
                        <b><%= Number(c.total) || 0 %></b>
                    </div>
                <% }) %>
            </div>
        </article>
    </section>
</main>
<%- include('partials/foot') %>
