<%# Shows lost-item posts in the admin area. %>
<%- include('partials/head', { title: 'Manage Items' }) %>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/flash') %>

    <header class="page-head">
        <div><h1>Manage Items</h1><p>Everything users reported as lost or found.</p></div>
    </header>

    <% const initialTab = locals.tab === 'found' ? 'found' : 'lost'; %>

    <div class="tabs" data-tabs role="tablist">
        <button type="button" class="tab <%= initialTab === 'lost' ? 'active' : '' %>" data-tab="lost" role="tab">Lost items <span class="badge badge-neutral" style="margin-left:6px"><%= lostItems.length %></span></button>
        <button type="button" class="tab <%= initialTab === 'found' ? 'active' : '' %>" data-tab="found" role="tab">Found items <span class="badge badge-neutral" style="margin-left:6px"><%= foundItems.length %></span></button>
    </div>

    <% [['lost', lostItems], ['found', foundItems]].forEach(function (g) {
        const kind = g[0], list = g[1], tid = kind + 'Table'; %>
        <section class="panel" data-panel="<%= kind %>" <%= initialTab === kind ? '' : 'hidden' %>>
            <div class="toolbar">
                <label class="search">
                    <%- icon('search') %>
                    <input class="input" type="search" placeholder="Search item, category or reporter" data-search="<%= tid %>" aria-label="Search <%= kind %> items">
                </label>
                <button type="button" class="btn btn-ghost btn-sm spacer" data-export="<%= tid %>" data-name="<%= kind %>-items"><%- icon('download') %>Export CSV</button>
            </div>

            <div class="table-wrap">
                <table class="table" id="<%= tid %>">
                    <thead><tr><th>Item</th><th>Category</th><th>Reported by</th><th>Location</th><th><%= kind === 'lost' ? 'Date lost' : 'Date found' %></th><th>Status</th><th class="num">Details</th></tr></thead>
                    <tbody>
                    <% list.forEach(function (it) { %>
                        <tr data-row>
                            <td>
                                <div class="cell-user">
                                    <% if (it.photo) { %>
                                        <img class="thumb" src="<%= it.photo %>" alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'thumb',textContent:'No photo'}))">
                                    <% } else { %>
                                        <span class="thumb"><%- icon('image') %></span>
                                    <% } %>
                                    <div><strong><%= it.item_name %></strong><small>#<%= it.id %></small></div>
                                </div>
                            </td>
                            <td><%= it.category_name || '—' %></td>
                            <td><%= it.reporter || 'Unknown' %></td>
                            <td style="max-width:220px"><%= it.location || '—' %></td>
                            <td><%= fmtDate(it.item_date) %></td>
                            <td><span class="badge <%= badge(it.status) %>"><%= it.status || 'unknown' %></span></td>
                            <td><div class="row-actions"><button type="button" class="btn btn-ghost btn-sm" data-view data-kind="<%= kind %>" data-id="<%= it.id %>">View</button></div></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="empty" data-empty="<%= tid %>" <%= list.length ? 'hidden' : '' %>><%- icon('box') %><p>No <%= kind %> items reported yet.</p></div>
            <div class="panel-foot"><span>Showing <b data-count="<%= tid %>"><%= list.length %></b> of <%= list.length %> <%= kind %> items</span></div>
        </section>
    <% }) %>
</main>

<!-- ITEM DETAILS -->
<div class="modal" id="itemModal" role="dialog" aria-modal="true" aria-labelledby="itemTitle">
    <div class="modal-card">
        <div class="modal-head"><h2 id="itemTitle">Item details</h2><button type="button" class="modal-x" data-close aria-label="Close"><%- icon('x') %></button></div>
        <div class="modal-body">
            <img class="detail-photo" id="dPhoto" alt="" hidden>
            <dl class="detail-list">
                <dt>Item</dt><dd id="dName"></dd>
                <dt>Type</dt><dd id="dKind"></dd>
                <dt>Status</dt><dd id="dStatus"></dd>
                <dt>Category</dt><dd id="dCategory"></dd>
                <dt id="dDateLabel">Date</dt><dd id="dDate"></dd>
                <dt>Location</dt><dd id="dLocation"></dd>
                <dt>Reported by</dt><dd id="dReporter"></dd>
                <dt>Contact</dt><dd id="dContact"></dd>
                <dt>Posted</dt><dd id="dPosted"></dd>
                <dt>Description</dt><dd id="dDescription"></dd>
            </dl>
        </div>
        <div class="modal-foot"><button type="button" class="btn btn-primary" data-close>Close</button></div>
    </div>
</div>

<script type="application/json" id="itemsData"><%- JSON.stringify({ lost: lostItems, found: foundItems }).replace(/</g, '\\u003c') %></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var data = JSON.parse(document.getElementById('itemsData').textContent);
        var $ = function (id) { return document.getElementById(id); };
        var fmt = function (d) { if (!d) return '—'; var x = new Date(d); return isNaN(x) ? '—' : x.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }); };

        document.addEventListener('click', function (e) {
            var b = e.target.closest('[data-view]');
            if (!b) return;
            var it = (data[b.dataset.kind] || []).find(function (x) { return String(x.id) === b.dataset.id; });
            if (!it) return;

            var photo = $('dPhoto');
            if (it.photo) { photo.src = it.photo; photo.hidden = false; photo.onerror = function () { photo.hidden = true; }; } else { photo.hidden = true; }

            $('dName').textContent = it.item_name || '—';
            $('dKind').textContent = b.dataset.kind === 'lost' ? 'Lost item' : 'Found item';
            $('dStatus').textContent = it.status || '—';
            $('dCategory').textContent = it.category_name || '—';
            $('dDateLabel').textContent = b.dataset.kind === 'lost' ? 'Date lost' : 'Date found';
            $('dDate').textContent = fmt(it.item_date);
            $('dLocation').textContent = it.location || '—';
            $('dReporter').textContent = it.reporter || 'Unknown';
            $('dContact').textContent = [it.reporter_email, it.reporter_contact].filter(Boolean).join(' · ') || '—';
            $('dPosted').textContent = fmt(it.created_at);
            $('dDescription').textContent = it.description || '—';
            FB.openModal('itemModal');
        });
    });
</script>
<%- include('partials/foot') %>
