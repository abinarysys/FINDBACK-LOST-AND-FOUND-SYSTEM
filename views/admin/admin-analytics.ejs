<%- include('partials/head', { title: 'Analytics' }) %>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/flash') %>
    <% const a = locals.analytics || {};
       const au = a.users || {}, ac = a.claims || {}; %>

    <header class="page-head">
        <div><h1>Analytics</h1><p>Monitor your lost and found system performance.</p></div>
    </header>

    <section class="stats">
        <div class="stat"><span class="stat-icon"><%- icon('users') %></span><div><p>Active Users</p><strong><%= au.activeUsers || 0 %></strong></div></div>
        <div class="stat"><span class="stat-icon"><%- icon('search') %></span><div><p>Items Lost</p><strong><%= a.lostItems || 0 %></strong></div></div>
        <div class="stat"><span class="stat-icon ok"><%- icon('box') %></span><div><p>Items Found</p><strong><%= a.foundItems || 0 %></strong></div></div>
        <div class="stat"><span class="stat-icon ok"><%- icon('check') %></span><div><p>Claims Approved</p><strong><%= ac.approvedClaims || 0 %></strong></div></div>
        <div class="stat"><span class="stat-icon warn"><%- icon('flag') %></span><div><p>Pending Reviews</p><strong><%= ac.pendingClaims || 0 %></strong></div></div>
    </section>

    <section class="panel" style="margin-bottom:20px">
        <div class="panel-head">
            <div><h2>Lost and found items over time</h2><p>Monthly overview of reported items</p></div>
            <span class="badge badge-primary">Last 12 months</span>
        </div>
        <div class="panel-body">
            <div class="chart-box"><canvas id="monthlyChart" aria-label="Monthly lost and found items chart" role="img"></canvas></div>
            <p class="help" id="chartFallback" hidden>The chart could not load (Chart.js needs internet access).</p>
        </div>
    </section>

    <section class="grid-2">
        <article class="panel">
            <div class="panel-head"><div><h2>Recent claims</h2><p>Latest claim requests</p></div></div>
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Claim</th><th>Claimant</th><th>Item</th><th>Category</th><th>Status</th></tr></thead>
                    <tbody>
                    <% if ((a.recentClaims || []).length) { %>
                        <% a.recentClaims.forEach(function (c) { %>
                            <tr>
                                <td>#<%= c.claim_id %></td>
                                <td><%= c.full_name || 'Unknown' %></td>
                                <td><%= c.item_name || '—' %></td>
                                <td><%= c.category_name || 'Other' %></td>
                                <td><span class="badge <%= badge(c.status) %>"><%= c.status || 'pending' %></span></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="5"><div class="empty">No claims yet.</div></td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel">
            <div class="panel-head"><div><h2>Top categories</h2><p>Share of all reports</p></div></div>
            <div class="panel-body">
                <% if ((a.categoryStats || []).length) { %>
                    <% a.categoryStats.forEach(function (c) { %>
                        <div class="bar-row">
                            <span><%= c.category_name || 'Uncategorized' %></span>
                            <div class="bar"><i data-w="<%= Math.min(100, Number(c.percentage) || 0) %>"></i></div>
                            <b><%= Number(c.percentage) || 0 %>%</b>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty">No category data yet.</div>
                <% } %>
            </div>
        </article>
    </section>
</main>

<script type="application/json" id="monthlyData"><%- JSON.stringify(a.monthlyItems || []).replace(/</g, '\\u003c') %></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var canvas = document.getElementById('monthlyChart');
        if (typeof Chart === 'undefined') { document.getElementById('chartFallback').hidden = false; return; }
        var rows = [];
        try { rows = JSON.parse(document.getElementById('monthlyData').textContent || '[]'); } catch (e) {}
        var css = getComputedStyle(document.documentElement);
        var primary = css.getPropertyValue('--primary').trim() || '#7C18FF';
        var muted = css.getPropertyValue('--muted').trim() || '#81768C';
        var grid = css.getPropertyValue('--border').trim() || '#E7E2ED';

        new Chart(canvas, {
            type: 'bar',
            data: {
                labels: rows.map(function (r) { return r.label; }),
                datasets: [
                    { label: 'Lost', data: rows.map(function (r) { return r.lostItems; }), backgroundColor: primary, borderRadius: 6, maxBarThickness: 22 },
                    { label: 'Found', data: rows.map(function (r) { return r.foundItems; }), backgroundColor: '#C05BCF', borderRadius: 6, maxBarThickness: 22 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { labels: { color: muted, usePointStyle: true, boxWidth: 8 } } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: muted } },
                    y: { beginAtZero: true, ticks: { precision: 0, color: muted }, grid: { color: grid } }
                }
            }
        });
    });
</script>
<%- include('partials/foot') %>
