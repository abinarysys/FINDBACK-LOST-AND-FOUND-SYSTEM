<%- include('partials/head', { title: 'User Verification' }) %>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/flash') %>

    <header class="page-head">
        <div><h1>User Verification</h1><p>Approve or reject new users before they can be trusted on FindBack.</p></div>
    </header>

    <%
        const count = function (s) { return users.filter(function (u) { return u.verification_status === s; }).length; };
    %>
    <section class="panel">
        <div class="toolbar">
            <label class="search">
                <%- icon('search') %>
                <input class="input" type="search" placeholder="Search name, email or number" data-search="verifyTable" aria-label="Search users">
            </label>
            <div class="chips">
                <button type="button" class="chip active" data-filter="verifyTable" data-key="v" data-value="">All <em><%= users.length %></em></button>
                <button type="button" class="chip" data-filter="verifyTable" data-key="v" data-value="pending">Pending <em><%= count('pending') %></em></button>
                <button type="button" class="chip" data-filter="verifyTable" data-key="v" data-value="verified">Verified <em><%= count('verified') %></em></button>
                <button type="button" class="chip" data-filter="verifyTable" data-key="v" data-value="rejected">Rejected <em><%= count('rejected') %></em></button>
            </div>
        </div>

        <div class="table-wrap">
            <table class="table" id="verifyTable">
                <thead><tr><th>User</th><th>Contact</th><th>Submitted</th><th>Account</th><th>Verification</th><th class="num">Action</th></tr></thead>
                <tbody>
                <% users.forEach(function (u) { %>
                    <tr data-row data-v="<%= u.verification_status %>">
                        <td><div class="cell-user"><%- avatar(u.full_name, u.profile_image) %><div><strong><%= u.full_name %></strong><small><%= u.email %></small></div></div></td>
                        <td><%= u.contact_number || '—' %></td>
                        <td><%= fmtDate(u.created_at) %></td>
                        <td><span class="badge <%= badge(u.account_status) %>"><%= u.account_status %></span></td>
                        <td><span class="badge <%= badge(u.verification_status) %>"><%= u.verification_status %></span></td>
                        <td>
                            <div class="row-actions">
                                <% if (u.verification_status !== 'verified') { %>
                                    <button class="btn btn-success btn-sm" data-action data-method="PATCH"
                                            data-url="/admin/users/<%= u.user_id %>/verification" data-body='{"status":"verified"}'><%- icon('check') %>Approve</button>
                                <% } %>
                                <% if (u.verification_status !== 'rejected') { %>
                                    <button class="btn btn-danger btn-sm" data-action data-method="PATCH"
                                            data-url="/admin/users/<%= u.user_id %>/verification" data-body='{"status":"rejected"}'
                                            data-confirm="Reject <%= u.full_name %>?"><%- icon('x') %>Reject</button>
                                <% } %>
                                <% if (u.verification_status !== 'pending') { %>
                                    <button class="btn btn-ghost btn-sm" data-action data-method="PATCH"
                                            data-url="/admin/users/<%= u.user_id %>/verification" data-body='{"status":"pending"}'>Reset</button>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
        <div class="empty" data-empty="verifyTable" <%= users.length ? 'hidden' : '' %>><%- icon('shield') %><p>No users to verify.</p></div>
        <div class="panel-foot"><span>Showing <b data-count="verifyTable"><%= users.length %></b> of <%= users.length %> users</span></div>
    </section>
</main>
<%- include('partials/foot') %>
