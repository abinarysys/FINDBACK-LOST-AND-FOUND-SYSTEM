<%# Lists recorded actions so administrators can review recent activity. %>
<%- include('partials/head', { title: 'Activity Logs' }) %>
<body>
<%- include('partials/sidebar') %>
<main class="main">
    <%- include('partials/flash') %>

    <header class="page-head">
        <div><h1>Activity Logs</h1><p>Track what admins do and how accounts are growing.</p></div>
    </header>

    <nav class="tabs" aria-label="Activity log type">
        <a class="tab <%= tab === 'admins' ? 'active' : '' %>" href="/admin/activity-logs">Admin activity</a>
        <a class="tab <%= tab === 'accounts' ? 'active' : '' %>" href="/admin/activity-logs?tab=accounts">User accounts</a>
    </nav>

    <% if (tab === 'admins') { %>

        <% if (logsMissing) { %>
            <div class="alert alert-info"><%- icon('clock') %><span>The activity table does not exist yet. Run <b>sql/admin-update.sql</b> once in MySQL, then actions will start appearing here.</span></div>
        <% } %>

        <section class="panel">
            <div class="toolbar">
                <label class="search">
                    <%- icon('search') %>
                    <input class="input" type="search" placeholder="Search activity" data-search="adminLogTable" aria-label="Search activity">
                </label>

                <form method="GET" action="/admin/activity-logs" class="chips" style="gap:8px">
                    <select class="select" name="admin" aria-label="Filter by admin" style="min-height:36px;padding:4px 12px;width:auto" onchange="this.form.submit()">
                        <option value="">All admins</option>
                        <% adminOptions.forEach(function (a) { %>
                            <option value="<%= a.user_id %>" <%= String(filters.admin) === String(a.user_id) ? 'selected' : '' %>><%= a.full_name %></option>
                        <% }) %>
                    </select>
                    <select class="select" name="action" aria-label="Filter by action" style="min-height:36px;padding:4px 12px;width:auto" onchange="this.form.submit()">
                        <option value="">All actions</option>
                        <% actionOptions.forEach(function (a) { %>
                            <option value="<%= a.action %>" <%= filters.action === a.action ? 'selected' : '' %>><%= actionLabel(a.action) %></option>
                        <% }) %>
                    </select>
                    <% if (filters.admin || filters.action) { %><a class="btn btn-ghost btn-sm" href="/admin/activity-logs">Clear</a><% } %>
                </form>

                <button type="button" class="btn btn-ghost btn-sm spacer" data-export="adminLogTable" data-name="admin-activity"><%- icon('download') %>Export CSV</button>
            </div>

            <div class="table-wrap">
                <table class="table" id="adminLogTable">
                    <thead><tr><th>When</th><th>Admin</th><th>Action</th><th>Details</th><th>IP address</th></tr></thead>
                    <tbody>
                    <% adminLogs.forEach(function (l) { %>
                        <tr data-row>
                            <td title="<%= fmtDateTime(l.created_at) %>"><%= fmtDateTime(l.created_at) %></td>
                            <td><div class="cell-user"><%- avatar(l.admin_name, l.admin_image, 'av-sm') %><div><strong><%= l.admin_name || 'Admin #' + l.admin_id %></strong><small><%= l.admin_email || '' %></small></div></div></td>
                            <td><span class="badge <%= actionTone(l.action) %>"><%= actionLabel(l.action) %></span></td>
                            <td><%= l.details || '—' %><% if (l.target_type) { %><br><small class="muted"><%= l.target_type %><%= l.target_id ? ' #' + l.target_id : '' %></small><% } %></td>
                            <td><%= l.ip_address || '—' %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="empty" data-empty="adminLogTable" <%= adminLogs.length ? 'hidden' : '' %>><%- icon('clock') %><p>No admin activity recorded yet.</p></div>
            <div class="panel-foot"><span>Showing <b data-count="adminLogTable"><%= adminLogs.length %></b> records (latest 500)</span></div>
        </section>

    <% } else { %>

        <section class="panel">
            <div class="toolbar">
                <label class="search">
                    <%- icon('search') %>
                    <input class="input" type="search" placeholder="Search accounts" data-search="accountTable" aria-label="Search accounts">
                </label>
                <div class="chips">
                    <button type="button" class="chip active" data-filter="accountTable" data-key="role" data-value="">All</button>
                    <button type="button" class="chip" data-filter="accountTable" data-key="role" data-value="user">Users</button>
                    <button type="button" class="chip" data-filter="accountTable" data-key="role" data-value="admin">Admins</button>
                </div>
                <button type="button" class="btn btn-ghost btn-sm spacer" data-export="accountTable" data-name="accounts"><%- icon('download') %>Export CSV</button>
            </div>

            <div class="table-wrap">
                <table class="table" id="accountTable">
                    <thead><tr><th>Account</th><th>Role</th><th>Verification</th><th>Status</th><th>Joined</th></tr></thead>
                    <tbody>
                    <% accounts.forEach(function (u) { %>
                        <tr data-row data-role="<%= u.role %>">
                            <td><div class="cell-user"><%- avatar(u.full_name, u.profile_image, 'av-sm') %><div><strong><%= u.full_name %></strong><small><%= u.email %></small></div></div></td>
                            <td><span class="badge <%= u.role === 'admin' ? 'badge-primary' : 'badge-neutral' %>"><%= u.role %></span></td>
                            <td><span class="badge <%= badge(u.verification_status) %>"><%= u.verification_status %></span></td>
                            <td><span class="badge <%= badge(u.account_status) %>"><%= u.account_status %></span></td>
                            <td><%= fmtDateTime(u.created_at) %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="empty" data-empty="accountTable" <%= accounts.length ? 'hidden' : '' %>><%- icon('users') %><p>No accounts yet.</p></div>
            <div class="panel-foot"><span>Showing <b data-count="accountTable"><%= accounts.length %></b> accounts</span></div>
        </section>

    <% } %>
</main>
<%- include('partials/foot') %>
