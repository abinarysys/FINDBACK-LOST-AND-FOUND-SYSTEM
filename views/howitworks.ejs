<%# These four cards explain the steps from posting an item to contacting its owner. %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/svg+xml" href="/img/icon/icon.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/user/tokens.css">
    <link rel="stylesheet" href="/css/public-base.css">
    <link rel="stylesheet" href="/css/howitworks.css">
    <title>HOW IT WORKS</title>
</head>
<body class="page-hiw" data-theme-aware>
    <%- include('user/partials/navbar', { user: user }) %>

    <main class="hiw-page">

        <!-- Page title and short introduction. -->
        <section class="hiw-hero">
            <span class="hiw-pill">HOW IT WORKS</span>
            <h1>How It <span>Works</span></h1>
            <p>Find or report a lost item in just a few simple steps.</p>
        </section>

        <!-- Four cards explaining the reporting and contact flow. -->
        <section class="hiw-steps">
            <article class="hiw-card">
                <div class="hiw-card-top">
                    <span class="hiw-badge">01</span>
                    <img src="/img/local-img/hiw-step1.png" alt="Report an item checklist">
                </div>
                <h3>Report an Item</h3>
                <p>Choose whether you lost an item or found an item. Provide the item name, description, photo, location, and date.</p>
            </article>

            <article class="hiw-card">
                <div class="hiw-card-top">
                    <span class="hiw-badge">02</span>
                    <img src="/img/local-img/hiw-step2.jpg" alt="Person searching through items">
                </div>
                <h3>Browse Items</h3>
                <p>Browse recent Lost &amp; Found posts or use the search bar to find an item that matches what you are looking for.</p>
            </article>

            <article class="hiw-card">
                <div class="hiw-card-top">
                    <span class="hiw-badge">03</span>
                    <img src="/img/local-img/hiw-step3.jpg" alt="Item details page">
                </div>
                <h3>View Item Details</h3>
                <p>Open a post to see the item's photo, description, location, and date.</p>
            </article>

            <article class="hiw-card">
                <div class="hiw-card-top">
                    <span class="hiw-badge">04</span>
                    <img src="/img/local-img/hiw-step4.jpg" alt="Phone with chat messages">
                </div>
                <h3>Contact</h3>
                <p>If you find a matching item, contact the person who posted it and provide the necessary information to verify the item.</p>
            </article>

            <article class="hiw-card">
                <div class="hiw-card-top">
                    <span class="hiw-badge">05</span>
                    <img src="/img/local-img/hiw-step5.png" alt="Phone with chat messages">
                </div>
                <h3>Return the Item</h3>
                <p>Once the item is verified, arrange a safe way to return the lost item to its rightful owner.</p>
            </article>
        </section>

        <p class="hiw-tagline">together, we can help lost items find their way home.</p>

        <!-- Background information about FindBack. -->
        <section class="hiw-about">
            <span class="hiw-pill">ABOUT US</span>
            <h2>Helping Lost Items <span>Find Their Way Home</span></h2>
            <p class="hiw-about-text">
                Our Lost &amp; Found platform is designed to make reporting and finding lost items easier, faster, and more organized.
            </p>
            <p class="hiw-about-text">
                We provide a simple space where people can report lost items, report found items, browse posts and connect with others who may be able to help return an item to its rightful owner.
            </p>

            <div class="hiw-about-bottom">
                <p class="hiw-mission">
                    To create a convenient and accessible Lost &amp; Found platform that helps people reconnect with their belongings through a simple and organized reporting system.
                </p>

                <div class="hiw-features">
                    <div class="hiw-feature">
                        <h4>Easy Reporting</h4>
                        <p>Submit lost or found item reports with essential details.</p>
                    </div>
                    <div class="hiw-feature">
                        <h4>Clear Details</h4>
                        <p>View useful details such as location, date, description, and photos.</p>
                    </div>
                    <div class="hiw-feature">
                        <h4>Easy Searching</h4>
                        <p>Browse and search posts to find items quickly.</p>
                    </div>
                    <div class="hiw-feature">
                        <h4>Community Connection</h4>
                        <p>Help owners and finders connect and communicate about lost belongings.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('user/partials/public-footer') %>
</body>
</html>
