<%# Shared navigation for sign-in and registration pages. %>
<% const navUser = locals.user; %>
<header class="nav">
    <a class="logo" href="/"><img src="/img/logo.png" alt="FindBack Logo"></a>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="authMainNav">
        <span></span><span></span><span></span>
    </button>
    <nav class="nav-links" id="authMainNav" aria-label="Main">
        <a href="/">Home</a>
        <a href="/browse">Browse Items</a>
        <a href="/howitworks">How It Works</a>
        <a href="/contacts">Contact Us</a>
    </nav>
    <div class="right-buttons">
        <% if (navUser) { %>
            <div class="profilepic">
                <a href="/user/profile"><img src="<%= navUser.profile_image %>" alt="<%= navUser.full_name %> profile picture"></a>
                <a href="/auth/logout">Log Out</a>
            </div>
        <% } else { %>
            <a href="/auth/login">Login</a>
            <a href="/auth/register">Get Started</a>
        <% } %>
    </div>
</header>

<script>
(function () {
    var nav = document.querySelector('.auth-page .nav');
    var toggle = nav && nav.querySelector('.nav-toggle');
    if (!nav || !toggle) return;

    function closeMenu() {
        nav.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
    }

    toggle.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
    nav.querySelectorAll('.nav-links a').forEach(function (link) {
        link.addEventListener('click', closeMenu);
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeMenu();
    });
    document.addEventListener('click', function (event) {
        if (!nav.contains(event.target)) closeMenu();
    });
})();
</script>
