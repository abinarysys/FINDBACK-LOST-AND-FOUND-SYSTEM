<%
    const iconName = String(locals.name || '')
        .trim()
        .toLowerCase()
        .replace(/&/g, 'and')
        .replace(/\s+/g, ' ');
    const iconMap = {
        electronics: '\u{1F4F1}',
        bags: '\u{1F392}',
        'ids and cards': '\u{1FAAA}',
        keys: '\u{1F511}',
        clothing: '\u{1F455}',
        accessories: '\u{231A}',
        wallets: '\u{1F45B}',
        others: '\u{1F4E6}'
    };
    const icon = iconMap[iconName] || '\u{1F3F7}\u{FE0F}';
%><span class="cat-icon" aria-hidden="true"><%= icon %></span>
